<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Shizuku 13 declares minSdk 24. This app stays at 23; the hub only calls
         it on the Android 9 head unit, which is well above that. -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <!-- Used to find/resize the freeform popup task so it stays in a fixed left slot. -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- YouTube (and some other players) only expose cover art as an https thumbnail URL. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Idle navigation glance: last-known city/street when AA is not guiding.
         No runtime prompt; if the grant is missing the card stays silent. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- APP+APP floating control must sit above freeform app windows. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- MEDIA rail Visualizer(session 0) prototype — may still return silence on the MMI. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- PersistBackup: settings + trips.db copied to /sdcard/HavalH6Viewer, survives reinstall -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- GWM hub Reboot. Shizuku shows its own grant dialog the first time. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Impulse Launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:resizeableActivity="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!-- What Impulse may ask of this build. Impulse reads it with GET_META_DATA (no launch, no
             bind) and hides the options a viewer of this age cannot answer - it ships ahead of us,
             so "is it installed" is not enough on its own. See ViewerPresencePolicy over there:
             1 = the client API (vehicle commands, setting writes, the CLIMA popup's keys).
             2 = the climate hand-off: binds ViewerClimateBridgeService, so Impulse keeps the
                 OEM A/C app disabled and this app shows the popup instead (ClimateHandoff).
             Raise this in the same commit that adds the feature Impulse gates on it. -->
        <meta-data
            android:name="impulse.api"
            android:value="2" />
        <!-- Receives Shizuku's binder. multiprocess must stay false and exported true. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL">
            <meta-data
                android:name="moe.shizuku.client.V3_SUPPORT"
                android:value="true" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".MediaNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".DesktopSwitcherHitService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/desktop_switcher_hit" />
        </service>
    </application>
</manifest>
