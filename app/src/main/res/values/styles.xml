<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- false: the MMI's own status header and left nav bar stay visible. -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorAccent">#4fd6e8</item>
        <!-- Our window has DRAWS_SYSTEM_BAR_BACKGROUNDS, so these are the scrims WE
             paint behind the MMI's bars. Left unset, statusBarColor inherits
             Material.Light's colorPrimaryDark — the light grey header. Transparent
             lets the viewer's own background run under both bars instead. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
