    <!-- No background plate: this sits directly on a card, so it must be
         transparent outside the mark itself. Two-tone triangle (light/dark
         blue outer, white/grey inner) reads as the familiar AA pictogram
         without a background box behind it. -->
    <group
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:pivotX="48"
        android:pivotY="48">
        <path
            android:fillColor="#29B6F6"
            android:pathData="M48,8 L8,78 H48 Z" />
        <path
            android:fillColor="#0277BD"
            android:pathData="M48,8 L88,78 H48 Z" />
        <path
            android:fillColor="#FAFAFA"
            android:pathData="M48,28 L26,68 H48 Z" />
        <path
            android:fillColor="#E1E1E1"
            android:pathData="M48,28 L70,68 H48 Z" />
    </group>
</vector>
