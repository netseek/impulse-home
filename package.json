{
  "name": "haval-h6-scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-app-icons.mjs",
    "inspect": "node scripts/inspect-glbs.mjs",
    "merge": "node scripts/merge-rear-fix.mjs",
    "build:lite-wheel": "node scripts/build-lite-wheel.mjs",
    "flatten:wheel": "node scripts/flatten-wheel-face.mjs",
    "dedup:textures": "node scripts/dedup-textures.mjs",
    "build:strip-hev-wheels": "node scripts/strip-embedded-hev-wheels.mjs",
    "build:lite-textures": "node scripts/build-lite-textures.mjs",
    "build:ktx2-textures": "node scripts/build-ktx2-textures.mjs",
    "build:fast-models": "node scripts/build-fast-models.mjs",
    "smooth:hev-body": "node scripts/smooth-hev-body.mjs",
    "smooth:hev-wheel": "node scripts/smooth-hev-wheel.mjs",
    "patch:hev-wheel-material": "node scripts/patch-hev-wheel-material.mjs",
    "verify:wheel-thumbnails": "node scripts/verify-wheel-thumbnails.mjs",
    "prepare:android-www": "node scripts/prepare-android-www.mjs",
    "build:splash-video": "node scripts/encode-splash-mp4.mjs",
    "build:powertrain": "node scripts/build-powertrain-model.mjs",
    "build:powertrain-lite": "node scripts/build-powertrain-model.mjs --lite --draco",
    "build:powertrain-textures": "node scripts/build-powertrain-textures.mjs",
    "analyze:rims": "node scripts/analyze-rim-symmetry.mjs assets/wheels",
    "car:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-car.ps1",
    "car:share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/share-car-displays.ps1",
    "car:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-car.ps1",
    "car:deploy:skip-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-car.ps1 -SkipBuild",
    "car:wait-and-deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wait-and-deploy-car.ps1",
    "emu:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-emulator.ps1",
    "emu:deploy:skip-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-emulator.ps1 -SkipBuild",
    "car:perf": "node scripts/device-perf.mjs",
    "car:perf:assert": "node scripts/device-perf.mjs --assert --sec 12",
    "car:perf:watch": "node scripts/device-perf.mjs --watch",
    "build:xray-ghost": "node scripts/build-xray-ghost.mjs",
    "analyze:ghost": "node scripts/analyze-ghost-candidate.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "draco3dgltf": "^1.5.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "three": "^0.170.0"
  }
}
